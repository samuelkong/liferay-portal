<%
String warning = "show-warning";

if(Validator.isNotNull(ddlFormAdminDisplayContext.getShowCSVWarning())) {
	warning = ddlFormAdminDisplayContext.getShowCSVWarning();
}

boolean showWarning = StringUtil.equals("show-warning", warning);

boolean forbidDownloading = StringUtil.equals("forbid-downloading-csv-file", warning);
%>

<div class="hide" id="<portlet:namespace />exportRecordSet">
	<aui:select label="file-extension" name="fileExtension">
		<c:if test="<%=!forbidDownloading %>">
			<aui:option value="csv">CSV</aui:option>
		</c:if>
		<aui:option value="xls">XLS</aui:option>
		<aui:option value="xml">XML</aui:option>
	</aui:select>

	<div id="<portlet:namespace />csvWarning"></div>
</div>

<aui:script use="aui-base,aui-alert">
	Liferay.provide(
		window,
		'<portlet:namespace />exportRecordSet',
		function(url) {
			var A = AUI();

			var form = A.Node.create('<form />');

			form.attr('method', 'POST');

			var content = A.one('#<portlet:namespace />exportRecordSet');

			var fileExtensionSelect = A.one('#<portlet:namespace />fileExtension');

			var csvWarning = A.one('#<portlet:namespace />csvWarning');

			var showCSVWarning = function(){
				if((fileExtensionSelect.val()==='csv') && (<%=showWarning %>)) {
					csvWarning.show();

					new A.Alert(
						{
							bodyContent: '<liferay-ui:message key="the-csv-warning-info" />',
							boundingBox: '#<portlet:namespace />csvWarning',
							closeable: false,
							cssClass: 'alert-warning',
							destroyOnHide: false,
							render: true
						}
					);
				}
				else {
					csvWarning.hide();
				}
			}
			
			if (content) {
				if(fileExtensionSelect) {
					showCSVWarning();
					fileExtensionSelect.on('change',showCSVWarning);
				}

				form.append(content);
				content.show();
			}

			var dialog = Liferay.Util.Window.getWindow(
				{
					dialog: {
						bodyContent: form,
						toolbars: {
							footer: [
								{
									label: '<liferay-ui:message key="ok" />',
									on: {
										click: function() {
											submitForm(form, url, false);

											dialog.hide();
										}
									},
									primary: true
								},
								{
									label: '<liferay-ui:message key="cancel" />',
									on: {
										click: function() {
											dialog.hide();
										}
									}
								}
							],
							header: [
								{
									cssClass: 'close',
									label: '\u00D7',
									on: {
										click: function(event) {
											dialog.hide();
										}
									}
								}
							]
						}
					},
					title: '<%= UnicodeLanguageUtil.get(request, "export") %>'
				}
			);
		},
		['liferay-util-window']
	);
</aui:script>